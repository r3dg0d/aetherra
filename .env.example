# AETHERRA environment. Copy to .env.local. Every variable is optional:
# the app runs with safe fallbacks and labels anything unavailable as UNAVAILABLE.
# Server-only secrets never reach the browser (only NEXT_PUBLIC_* do).

# --- Database -------------------------------------------------------------
# Postgres (recommended in production). If unset, an embedded PGlite database
# is used at PGLITE_DIR (default ./.data/pglite). Migrations run automatically.
DATABASE_URL=
PGLITE_DIR=

# --- Launch Library 2 (The Space Devs) ------------------------------------
# Default: https://ll.thespacedevs.com/2.3.0 in production, lldev in development.
LL2_BASE_URL=
# Optional API token (Patreon tier) for higher limits.
LL2_API_TOKEN=
# Hourly request budget enforced by the server (default 12 prod / 60 lldev / 200 with token).
LL2_MAX_REQUESTS_PER_HOUR=

# --- OpenSky Network -------------------------------------------------------
# OAuth2 client credentials (API client from your OpenSky account). Anonymous access works with lower limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- FAA SWIM (SCDS) -------------------------------------------------------
# Requires an approved FAA SCDS subscription. The consumer is a stub in this build (always UNAVAILABLE).
FAA_SWIM_JMS_URL=
FAA_SWIM_USERNAME=
FAA_SWIM_PASSWORD=
FAA_SWIM_QUEUE=

# --- Web Push (VAPID) ------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Cesium ion (optional) -------------------------------------------------
# Adds Cesium World Terrain and OSM Buildings in EARTH. Without it: ellipsoid + OSM tiles.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- Operations ------------------------------------------------------------
# Bearer token for POST /api/launches/refresh in production.
ADMIN_TOKEN=
# Set to "off" to disable the in-process 60 s scheduler (launch refresh, reminders, push queue).
AETHERRA_SCHEDULER=
# Override public endpoints (please respect their usage policies).
OVERPASS_URL=
NOMINATIM_URL=
